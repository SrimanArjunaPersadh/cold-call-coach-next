# Cold Call Coach — environment
#
# Same Supabase project, same keys, same values as the old app (plan §2). Copy to
# .env.local for `next dev`, and add the same set to the new Vercel project.
#
# Every one of these is server-side only. There are no NEXT_PUBLIC_ variables in
# this app and there must never be: §9 requires zero frontend lines carrying any
# token. The browser talks to /api/* with the shared secret and nothing else.

# --- Supabase ---------------------------------------------------------------
SUPABASE_URL=https://your-project-ref.supabase.co
# NOTE: plan §2 lists this as SUPABASE_ANON_KEY, but the old app's api/_supabase.js
# reads SUPABASE_SERVICE_ROLE_KEY and the routes depend on service-role access
# (private bucket, server-side clamps). The code is the source of truth here.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_RECORDINGS_BUCKET=recordings

# --- Transcription & scoring ------------------------------------------------
DEEPGRAM_API_KEY=your-deepgram-key
ANTHROPIC_API_KEY=your-anthropic-key
# Optional. Old app defaults to claude-haiku-4-5 when unset.
ANTHROPIC_MODEL=claude-haiku-4-5

# --- Auth -------------------------------------------------------------------
# Shared-secret gate. requireSecret() is line one of every route handler and
# fails closed (503) when this is missing.
APP_SECRET=your-long-random-passphrase
# Optional. Old app defaults to 'solo' when unset. Every query clamps to it.
PHASE1_USER_ID=solo

# --- Lead acquisition -------------------------------------------------------
# The APIFY_TOKEN (plan §2) vs APIFY_API_TOKEN (code) naming inconsistency is
# KNOWN and PRESERVED — plan §2 says do not fix it. The code reads this name.
APIFY_API_TOKEN=your-apify-token
